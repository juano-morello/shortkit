node_modules/
.pnpm-store/
dist/
build/
.next/
coverage/
*.tsbuildinfo

# Compiler output never belongs beside source. A build misconfigured with a
# rootDir that does not cover the workspace emits .js next to the .ts it came
# from, and `git add -A` would commit it.
apps/*/src/**/*.js
apps/*/src/**/*.js.map
packages/*/src/**/*.js
packages/*/src/**/*.js.map

# Credentials. This repository is public (ADR-0018), so anything secret that
# lands here is rotated, not deleted.
.env
.env.*
!.env.example
.envrc
.npmrc
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*

.DS_Store
*.log

# superpowers review packages: regenerable diffs, not source
.superpowers/
.vercel

# Added by `vercel link`. `.env*` re-shadows the `!.env.example` negation at line 25, so the
# negation is restated here: a pattern later in the file wins, and without this a new
# apps/api/.env.example — which F-169 requires TASK-009 to add — would be silently ignored.
.env*
!.env.example
!*/.env.example
!**/.env.example

# Generated by the TASK-006 isolation harness on every run (AC-12).
apps/api/test/isolation/report.json
