# Copy to `.env.local` for local development. On Vercel these are registered as
# Project Environment Variables, not committed files.
#
# See ADR-0014 (design/adr-0014-web-session-handling.md) and the contract at
# design/contracts/web-api-client.md.

# Browser-visible. Never used for anything authenticated — the browser only ever
# calls this same-origin app, never Fly directly (ADR-0014). Must include the
# API's global prefix: ADR-0006 sets it to `/api`, and the redirect controller is
# registered outside that prefix, so a base URL missing `/api` reaches the redirect
# surface instead of the JSON one.
NEXT_PUBLIC_API_BASE_URL=https://shortkit-api.fly.dev/api

# Server-only. Never prefix this (or BFF_PROXY_SECRET below) with NEXT_PUBLIC_ —
# that prefix inlines the value into the client bundle, which is exactly what
# `pnpm --filter @shortkit/web assert:no-secrets` (apps/web/scripts/assert-no-inlined-secrets.mjs)
# guards against. This is the origin the BFF proxy route (TASK-012) calls; it also
# must include `/api` (ADR-0006).
API_BASE_URL=https://shortkit-api.fly.dev/api

# Server-only. Shared with the Fly side. The API's constant-time match on this
# value is what it trusts before honouring a forwarded client address
# (`x-shortkit-client-ip`); published to the browser it would let anyone forge that
# header and collapse every IP-keyed rate limit into one shared bucket. Never
# logged on the Vercel side.
BFF_PROXY_SECRET=
