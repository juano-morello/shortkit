{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "paths": {
      "@shortkit/contracts": ["../../packages/contracts/src/index.ts"],
      "@shortkit/contracts/*": ["../../packages/contracts/src/*/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.setup.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}
