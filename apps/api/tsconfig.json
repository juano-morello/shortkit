{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsup bundles this workspace, so bundler resolution is what actually runs at
    // build time. It also reads package `exports` maps, which node10 ignored — a
    // dependency publishing types only through an exports subpath resolved to
    // TS2307 before. node16/nodenext would demand explicit `.js` extensions in
    // `packages/contracts`, which Turbopack then fails to resolve back to `.ts`.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    // TASK-2-02. `scripts/*.mts` are run by `node` with no build step, so their imports
    // are resolved by Node's ESM resolver, which needs the real filename — `seed.mts`
    // imports `../src/db/platform.ts` (the frozen platform uuids, ADR-0063) and an
    // extensionless specifier is ERR_MODULE_NOT_FOUND at runtime, measured. Without this
    // flag tsc rejects the only specifier that works. It is safe because `noEmit` is set:
    // tsc writes nothing, tsup bundles `src/**` with its own resolver, and the flag
    // permits a spelling rather than changing what any specifier resolves to.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "paths": {
      "@shortkit/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.setup.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "tsup.config.ts",
    "drizzle.config.ts",
    "scripts/**/*.mts"
  ]
}
