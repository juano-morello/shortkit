{
  "name": "@shortkit/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check-policies": "node scripts/check-policies.mts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@shortkit/contracts": "workspace:*",
    "better-auth": "1.6.26",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@swc/core": "1.15.46",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.4",
    "drizzle-kit": "0.31.10",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.10",
    "vitest": "3.2.7"
  }
}
